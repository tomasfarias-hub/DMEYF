    {
      "cell_type": "code",
      "source": [
        "#consolido las clases\n",
        "\n",
        "data['clase_binaria'] = np.where(data['clase_ternaria'] == 'BAJA+2', 1, 0)"
      ],
      "metadata": {
        "id": "zgDpY_M5OB1y"
