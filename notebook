        "leaf_df[\"prob_empirica\"] = leaf_df[\"BAJA+2\"] / leaf_df[\"Samples\"]\n",
        "leaf_df[\"prob_modelo_hoja\"] = 1 / (1 + np.exp(-leaf_df[\"valor_hoja\"]))\n",
        "\n",
        "leaf_df.sort_values(\"prob_modelo_hoja\", ascending=False, inplace=True)\n",
